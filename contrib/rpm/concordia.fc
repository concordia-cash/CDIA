/usr/bin/concordia-cli		--	gen_context(system_u:object_r:concordia_exec_t,s0)
/usr/sbin/concordiad		--	gen_context(system_u:object_r:concordia_exec_t,s0)
/usr/lib(64)?/concordia/concordiad		--	gen_context(system_u:object_r:concordia_exec_t,s0)

/etc/concordia(/.*)?		gen_context(system_u:object_r:concordia_conf_t,s0)
/var/lib/concordia(/.*)?		gen_context(system_u:object_r:concordia_var_lib_t,s0)

(/var)?/run/concordiad(/.*)?   gen_context(system_u:object_r:concordia_var_run_t,s0)

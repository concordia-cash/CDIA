policy_module(concordia, 1.100.1)

########################################
#
# Declarations
#

type concordia_t;
type concordia_exec_t;
init_daemon_domain(concordia_t, concordia_exec_t)

permissive concordia_t;

type concordia_initrc_exec_t;
init_script_file(concordia_initrc_exec_t)

type concordia_conf_t;
files_type(concordia_conf_t)

type concordia_var_lib_t;
files_type(concordia_var_lib_t)

type concordia_var_run_t;
files_type(concordia_var_run_t)

type concordia_port_t;
corenet_port(concordia_port_t)

########################################
#
# concordia local policy
#
allow concordia_t self:process { fork };

allow concordia_t self:fifo_file rw_fifo_file_perms;
allow concordia_t self:unix_stream_socket create_stream_socket_perms;

manage_dirs_pattern(concordia_t, concordia_conf_t, concordia_conf_t)
manage_files_pattern(concordia_t, concordia_conf_t, concordia_conf_t)

manage_dirs_pattern(concordia_t, concordia_var_lib_t, concordia_var_lib_t)
manage_files_pattern(concordia_t, concordia_var_lib_t, concordia_var_lib_t)
files_var_lib_filetrans(concordia_t, concordia_var_lib_t, { dir file })

manage_dirs_pattern(concordia_t, concordia_var_run_t, concordia_var_run_t)
manage_files_pattern(concordia_t, concordia_var_run_t, concordia_var_run_t)

sysnet_dns_name_resolve(concordia_t)
corenet_all_recvfrom_unlabeled(concordia_t)

allow concordia_t self:tcp_socket create_stream_socket_perms;
corenet_tcp_sendrecv_generic_if(concordia_t)
corenet_tcp_sendrecv_generic_node(concordia_t)
corenet_tcp_sendrecv_all_ports(concordia_t)
corenet_tcp_bind_generic_node(concordia_t)

gen_require(`
    type concordia_port_t;
')
allow concordia_t concordia_port_t:tcp_socket name_bind;

gen_require(`
    type concordia_port_t;
')
allow concordia_t concordia_port_t:tcp_socket name_connect;

domain_use_interactive_fds(concordia_t)

files_read_etc_files(concordia_t)

miscfiles_read_localization(concordia_t)

sysnet_dns_name_resolve(concordia_t)

allow concordia_t concordia_exec_t:file execute_no_trans;
allow concordia_t self:process setsched;
corecmd_exec_ls(concordia_t)
corenet_tcp_connect_http_port(concordia_t)
dev_read_urand(concordia_t)
fs_getattr_xattr_fs(concordia_t)
kernel_read_system_state(concordia_t)
